# INFONET Backend — Environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose the password in logs, screenshots, or prompts.

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
NEO4J_DATABASE=neo4j

API_HOST=127.0.0.1
API_PORT=8000
INFONET_QUERY_TIMEOUT_S=5
